# Tkinter Styling Notes:

# 1. Window Configuration:
#    - Title: The window title is set using `root.title("Python Structure Generator")`.
#    - Size: The window dimensions are specified as `400x600` using `root.geometry("400x600")`.
#    - Background Color: The background color of the entire window is set to white using `root.configure(bg="white")`.

root = tk.Tk()
root.title("Python Structure Generator")
root.geometry("400x600")
root.configure(bg="white")

# 2. Labels:
#    - Font: The `create_label()` function sets the default font to `"Verdana", 14, "bold"` for general labels, while smaller labels (e.g., for input fields) use `"Verdana", 12`. The main menu title uses a different font `"Helvetica", 16, "bold"`.
#    - Background Color: All labels have a white background (`bg="white"`).
#    - Padding: Labels are packed with vertical padding (`pady=10`).

def create_label(parent, text, font=("Verdana", 14, "bold")):
    label = tk.Label(parent, text=text, font=font, bg="white")
    label.pack(pady=10)
    return label

# 3. Buttons:
#    - Font: Buttons use the `"Verdana", 12, "bold"` font for styling.
#    - Width: On the main menu, buttons have a fixed width of 20 characters (`width=20`).
#    - Padding: Buttons are spaced vertically with padding (`pady=10`). On certain input pages, buttons have smaller padding (`pady=5`) for tighter spacing.

tk.Button(root, text="Create Class", command=class_input_page, font=("Verdana", 12, "bold"), width=20).pack(pady=10)
tk.Button(root, text="Back to Menu", command=main_menu, font=("Verdana", 12, "bold")).pack(pady=5)

# 4. Text Widget (for displaying generated code):
#    - Height: The height is set to 10 rows using `height=10`.
#    - Width: The width is set to 50 columns using `width=50`.
#    - Background Color: The text widget background color is white (`bg="white"`).
#    - Padding: The widget is packed with vertical padding (`pady=10`).

code_text = tk.Text(root, height=10, width=50, bg="white")
code_text.insert(tk.END, "Generated code will appear here")
code_text.pack(pady=10)

# 5. Frames:
#    - Background Color: Frames that hold entry fields and checkboxes have a white background (`bg="white"`).
#    - Padding: Frames are spaced vertically with padding (`pady=5`).

fields_frame = tk.Frame(root, bg="white")
fields_frame.pack(pady=5)

# 6. Checkbuttons (Checkboxes):
#    - Background Color: Checkbuttons have a white background (`bg="white"`).
#    - Font: Checkbuttons are styled with the `"Verdana", 12"` font.

var = tk.IntVar()
tk.Checkbutton(root, text="Args", variable=var, bg="white", font=("Verdana", 12)).pack(pady=5)

# 7. Entry Fields:
#    - Padding: Entry fields are packed with horizontal padding (`padx=5`) inside their frames for spacing.

entry = tk.Entry(fields_frame)
entry.pack(side=tk.LEFT, padx=5)
